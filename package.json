    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "sass": "^1.77.4",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
